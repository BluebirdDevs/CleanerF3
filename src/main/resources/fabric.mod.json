{
  "schemaVersion": 1,
  "id": "${id}",
  "name": "${name}",
  "version": "${version}",
  "authors": ["${authors}"],
  "contributors": ["${contributors}"],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}",
    "homepage": "${homepage_url}"
  },
  "description": "${description}",
  "icon": "assets/${id}/icon.png",
  "license": "${license}",
  "environment": "*",
  "accessWidener": "aw/${sc_version}.accesswidener",
  "entrypoints": {
    "main": [
      "${group}.${id}.platform.fabric.FabricEntrypoint"
    ],
    "client": [
      "${group}.${id}.platform.fabric.FabricClientEntrypoint"
    ],
    "modmenu": [
      "${group}.${id}.platform.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "depends": {},
  "suggests": {
    "cloth-config": "*"
  },
  "breaks": {
    "betterf3": "*"
  }
}
